{
  "name": "iot/worker",
  "build": {
    "context": "../../workspaces/worker/",
    "dockerfile": "../../workspaces/worker/Dockerfile"
  },
  "workspaceFolder": "/opt",
  "forwardPorts": [
    4010
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "EditorConfig.EditorConfig",
        "ctf0.macros",
        "mikestead.dotenv",
        "oderwat.indent-rainbow",
        "PKief.material-icon-theme",
        "yatki.vscode-surround"
      ]
    }
  }
}