{
  "name": "@iot/data",
  "version": "1.0.0",
  "description": "database admin code to create and interact with the database",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "infra": "docker compose --env-file .env up",
    "check": "tsc --noEmit --pretty",
    "dev": "concurrently -c auto 'npm:check -- --watch --preserveWatchOutput' 'npm:infra'",
    "check:cov": "type-coverage --detail --strict --ignore-catch --at-least 99",
    "build": "rm -rf dist/ && tsdown",
    "lint": "eslint src/",
    "fmt": "eslint --fix src/",
    "test": "vitest run",
    "test:debug": "pnpm run test -c vitest.debug.config.ts",
    "e2e": "vitest run -c vite.e2e.config.ts",
    "pull": "drizzle-kit pull",
    "push": "drizzle-kit push",
    "gen": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "seed": "npx tsx ./tasks/seed.task.ts --env development",
    "truncate": "npx tsx ./tasks/truncate.task.ts --env development",
    "push:secret": "npx tsx ./tasks/push.task.ts",
    "repo": "helm repo add bitnami https://charts.bitnami.com/bitnami",
    "manifest": "make manifest",
    "declare": "kubectl apply -f manifest.yml",
    "logs": "kubectl logs svc/postgres-postgresql --tail=100 -f",
    "forward": "kubectl port-forward svc/postgres-postgresql 5432:5432"
  },
  "dependencies": {
    "@iot/libs": "workspace:*",
    "@sindresorhus/is": "^7.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@eslint/js": "^9.36.0",
    "@faker-js/faker": "^10.1.0",
    "@testcontainers/postgresql": "^11.11.0",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/node": "^22",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.3.13",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.36.0",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^16.4.0",
    "tsdown": "^0.16.6",
    "tsx": "^4.20.6",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0",
    "vitest": "^4.0.18",
    "zx": "^8.8.5"
  }
}
