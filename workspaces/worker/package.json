{
  "name": "@iot/worker",
  "version": "1.0.0",
  "description": "nodejs code to store device's data into a postgres database",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "type": "module",
  "scripts": {
    "serve": "tsx --watch --env-file=.env src/main.ts",
    "start": "node dist/main.js",
    "check": "tsc --noEmit --pretty",
    "dev": "concurrently -c auto 'npm:check -- --watch --preserveWatchOutput' 'npm:serve'",
    "check:cov": "type-coverage --detail --strict --ignore-catch --at-least 100",
    "build": "rm -rf dist/ && tsc -p tsconfig.build.json",
    "lint": "eslint src/",
    "fmt": "eslint --fix src/",
    "test": "vitest run",
    "test:debug": "pnpm run test -c vitest.debug.config.ts",
    "containerize": "docker compose --progress plain build worker",
    "push": "tsx ./tasks/push.task.ts",
    "declare": "kubectl apply -f manifest.yml",
    "deploy": "kubectl rollout restart deployment worker",
    "logs": "kubectl logs svc/worker --tail=100 -f",
    "forward": "kubectl port-forward svc/worker 4010:4010"
  },
  "dependencies": {
    "@elysiajs/node": "^1.4.2",
    "@elysiajs/openapi": "^1.4.11",
    "@iot/data": "workspace:*",
    "@iot/libs": "workspace:*",
    "@sindresorhus/is": "^7.1.1",
    "elysia": "^1.4.16",
    "type-fest": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.0.6",
    "@vitest/eslint-plugin": "^1.3.13",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^16.4.0",
    "tsx": "^4.20.6",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0",
    "vitest": "^4.0.6",
    "zx": "^8.8.5"
  }
}
