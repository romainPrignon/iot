{
  "name": "@iot/libs",
  "version": "1.0.0",
  "description": "shared libraries",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "concurrently -c auto 'npm:check -- --watch --preserveWatchOutput' 'npm:test -- --watch'",
    "check": "tsc --noEmit --pretty",
    "check:cov": "type-coverage --detail --strict --ignore-catch --at-least 100",
    "build": "rm -rf dist/ && tsdown",
    "lint": "eslint src/",
    "fmt": "eslint --fix src/",
    "test": "vitest run",
    "test:debug": "pnpm run test -c vitest.debug.config.ts"
  },
  "dependencies": {
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@eslint/js": "^9.36.0",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.0.6",
    "@vitest/eslint-plugin": "^1.3.13",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^16.4.0",
    "tsdown": "^0.16.6",
    "tsx": "^4.20.6",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0",
    "vitest": "^4.0.6"
  }
}
